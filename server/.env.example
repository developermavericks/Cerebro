# Database (PostgreSQL — existing)
DB_USER=cerebro_admin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=6543
DB_NAME=cerebro_db

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Groq AI Engine
GROQ_API_KEY=gsk_your_groq_api_key

# BigQuery & GCP Storage
BQ_PROJECT_ID=cerebro-500508
BQ_DATASET=cerebro_dataset
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCS_BUCKET=your-news-data-bucket

# OpenPageRank
OPENPAGERANK_API_KEY=your-key-here

# Server
PORT=3001
JWT_SECRET=cerebro-jwt-secret-key-2026
SESSION_SECRET=cerebro-session-secret-key-2026

